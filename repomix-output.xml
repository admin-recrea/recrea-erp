                                        child: Text(
                                          initial,
                                          style: TextStyle(
                                            color: isRegular
                                                ? RecreaTheme.turquesa
                                                : RecreaTheme.amarillo,
                                            fontWeight: FontWeight.w900,
                                            fontSize: 14,
