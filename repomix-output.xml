                      ),
                      child: const Row(
                        children: [
                          Icon(Icons.verified_user_rounded, color: RecreaTheme.turquesa, size: 16),
                          SizedBox(width: 6),
                          Text(
                            'Pase Express Oficial',
                            style: TextStyle(fontWeight: FontWeight.bold, fontSize: 12, color: RecreaTheme.turquesa),
                          ),
                        ],
                      ),
                    ),
                    IconButton(
                      onPressed: () => Navigator.pop(ctx),
