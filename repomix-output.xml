                      borderRadius: BorderRadius.circular(16),
                    ),
                    child: Icon(
                      isRegular
                          ? Icons.school_rounded
                          : Icons.extension_rounded,
                      color: isRegular
                          ? RecreaTheme.turquesa
                          : RecreaTheme.rosa,
                      size: 28,
                    ),
                  ),
                  const SizedBox(width: 14),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Row(
                          children: [
                            Expanded(
                              child: Text(
                                c['name'] as String,
                                style: const TextStyle(
                                  fontWeight: FontWeight.w900,
                                  fontSize: 16,
                                  color: RecreaTheme.oscuro,
                                ),
                                maxLines: 1,
                                overflow: TextOverflow.ellipsis,
                              ),
                            ),
                          ],
                        ),
                        const SizedBox(height: 2),
                        Text(
                          'Docente: $teacherName',
                          style: const TextStyle(
                            fontSize: 12,
                            color: RecreaTheme.textoMudo,
                            fontWeight: FontWeight.w600,
                          ),
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                        ),
                        const SizedBox(height: 10), // Un poco más de aire
                        
                        // ÁREA INFERIOR CON BADGE Y BOTÓN ACCESIBLE
                        Row(
                          mainAxisAlignment: MainAxisAlignment.spaceBetween,
                          children: [
                            Container(
                              padding: const EdgeInsets.symmetric(
                                horizontal: 8,
                                vertical: 4,
                              ),
                              decoration: BoxDecoration(
                                color: RecreaTheme.fondoBase,
                                borderRadius: BorderRadius.circular(8),
                              ),
                              child: Text(
                                isRegular ? 'Turno Mañana' : 'Terapia Tarde',
                                style: const TextStyle(
                                  fontSize: 10,
                                  fontWeight: FontWeight.bold,
                                  color: RecreaTheme.oscuro,
                                ),
                                maxLines: 1,
                                overflow: TextOverflow.ellipsis,
                              ),
                            ),
                            // BOTÓN BENTO AMPLIO Y ACCESIBLE PARA LA DIRECTORA
                            if (_role == 'admin')
                              InkWell(
                                onTap: () => _showAssignTeacherDialog(Map<String, dynamic>.from(c)),
                                borderRadius: BorderRadius.circular(10),
                                child: Container(
                                  padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
                                  decoration: BoxDecoration(
                                    color: RecreaTheme.turquesaSuave,
                                    borderRadius: BorderRadius.circular(10),
                                  ),
                                  child: const Row(
                                    mainAxisSize: MainAxisSize.min,
                                    children: [
                                      Icon(
                                        Icons.edit_rounded,
                                        color: RecreaTheme.turquesa,
                                        size: 14,
