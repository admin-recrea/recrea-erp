  Widget _buildPaymentCard(Map payment, {required bool isPending}) {
    final student = payment['students'];
    final studentName = student != null ? '${student['first_names']} ${student['last_names']}' : 'Alumno(a)';
    final status = payment['status'].toString();

    Color statusColor;
    String statusText;

    if (status == 'PAGADO') {
      statusColor = RecreaTheme.verde;
      statusText = 'Validado por Admin';
    } else if (status == 'EN_REVISION') {
      statusColor = RecreaTheme.amarillo;
      statusText = 'En Verificación';
    } else if (status == 'RECHAZADO') {
      statusColor = RecreaTheme.rosa;
      statusText = 'Observado / Rechazado';
    } else {
      statusColor = RecreaTheme.textoMudo;
      statusText = 'Pendiente de Pago';
    }

    final createdAt = payment['created_at'] != null 
        ? DateFormat('dd/MM/yyyy HH:mm').format(DateTime.parse(payment['created_at'].toString()).toLocal()) 
        : '';
    final validatedAt = payment['validated_at'] != null 
        ? DateFormat('dd/MM/yyyy HH:mm').format(DateTime.parse(payment['validated_at'].toString()).toLocal()) 
        : '';

    return Card(
      margin: const EdgeInsets.only(bottom: 16),
      elevation: 0,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(20),
        side: const BorderSide(color: RecreaTheme.bordeClaro),
      ),
      child: Padding(
        padding: const EdgeInsets.all(20.0),
        child: Column(
          children: [
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(payment['concept']?.toString() ?? 'Pago', style: const TextStyle(fontWeight: FontWeight.w800, fontSize: 16, color: RecreaTheme.oscuro)),
                      const SizedBox(height: 4),
                      Text('Alumno: $studentName', style: const TextStyle(color: RecreaTheme.textoMudo, fontSize: 13, fontWeight: FontWeight.bold)),
                      const SizedBox(height: 8),
                      Text('Medio: ${payment['payment_method'] ?? '-'}  •  Op: ${payment['operation_number'] ?? '-'}', style: const TextStyle(fontSize: 12, color: RecreaTheme.textoMudo)),
                      Text('Enviado: $createdAt', style: const TextStyle(fontSize: 12, color: RecreaTheme.textoMudo)),
                      if (validatedAt.isNotEmpty)
                        Text('Validado: $validatedAt', style: TextStyle(fontSize: 12, color: statusColor, fontWeight: FontWeight.bold)),
                    ],
                  ),
                ),
                Text('S/ ${payment['amount']}', style: const TextStyle(fontWeight: FontWeight.w900, fontSize: 20, color: RecreaTheme.turquesa)),
              ],
            ),
            const Divider(height: 24),
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                  decoration: BoxDecoration(color: statusColor.withValues(alpha: 0.15), borderRadius: BorderRadius.circular(12)),
                  child: Text(statusText, style: TextStyle(color: statusColor, fontWeight: FontWeight.bold, fontSize: 12)),
                ),
                if (isPending)
                  ElevatedButton(
                    style: ElevatedButton.styleFrom(backgroundColor: RecreaTheme.turquesa, padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8)),
                    onPressed: () => _showSendVoucherDialog(existingPayment: payment),
                    child: const Text('Adjuntar Voucher', style: TextStyle(fontSize: 12)),
                  ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}
