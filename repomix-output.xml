                                              ),
                                              maxLines: 2,
                                              overflow: TextOverflow.ellipsis,
                                            ),
                                          ],
                                        ),
                                      ),
                                    ],
                                  );

                                  final actionButtons = Row(
                                    mainAxisSize: MainAxisSize.min,
                                    mainAxisAlignment: isMobileStudent
                                        ? MainAxisAlignment.end
                                        : MainAxisAlignment.start,
                                    children: [
                                      IconButton(
                                        icon: const Icon(
                                          Icons.folder_shared_rounded,
                                          color: RecreaTheme.turquesa,
                                          size: 22,
                                        ),
                                        tooltip: 'Ver Documentos',
                                        padding: EdgeInsets.zero,
                                        constraints: const BoxConstraints(),
                                        onPressed: () => _showStudentDocsDialog(
                                          Map<String, dynamic>.from(s),
                                        ),
                                      ),
                                      const SizedBox(width: 12),
                                      InkWell(
                                        onTap: _updatingStudentId == s['id']
                                            ? null
                                            : () => _toggleDocsVerified(
                                                s['id'] as String,
                                                docsVerified,
                                              ),
                                        borderRadius: BorderRadius.circular(10),
                                        child: AnimatedContainer(
                                          duration: const Duration(
                                            milliseconds: 200,
                                          ),
                                          padding: const EdgeInsets.symmetric(
                                            horizontal: 10,
                                            vertical: 8,
                                          ),
                                          decoration: BoxDecoration(
                                            color: docsVerified
                                                ? RecreaTheme.verdeSuave
                                                : RecreaTheme.amarilloSuave,
                                            borderRadius: BorderRadius.circular(
                                              10,
                                            ),
                                          ),
                                          child: Row(
                                            mainAxisSize: MainAxisSize.min,
                                            children: [
                                              if (_updatingStudentId == s['id'])
                                                SizedBox(
                                                  width: 14,
                                                  height: 14,
                                                  child:
                                                      CircularProgressIndicator(
                                                        strokeWidth: 2,
                                                        color: docsVerified
                                                            ? Colors.green[800]
                                                            : Colors
                                                                  .orange[800],
                                                      ),
                                                )
                                              else
                                                Icon(
                                                  docsVerified
                                                      ? Icons.verified_rounded
                                                      : Icons
                                                            .pending_actions_rounded,
                                                  color: docsVerified
                                                      ? RecreaTheme.verde
                                                      : RecreaTheme.amarillo,
                                                  size: 15,
                                                ),
                                              const SizedBox(width: 6),
                                              Text(
                                                docsVerified
                                                    ? 'Docs OK'
