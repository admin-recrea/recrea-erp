import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:printing/printing.dart';

class CarnetPdfService {
  /// Tamaño exacto de un DNI/Tarjeta de crédito en puntos PDF
  static const double carnetWidth = 242.5; // ~8.56 cm
  static const double carnetHeight = 153.0; // ~5.40 cm

  /// Imprime un listado de estudiantes (Admin: varios, Padre: solo uno)
  static Future<void> printCarnets(List students) async {
    final pdf = pw.Document();

    // Dividimos a los alumnos en bloques de 10 (máximo por hoja A4)
    for (var i = 0; i < students.length; i += 10) {
      final chunk = students.sublist(
        i,
        i + 10 > students.length ? students.length : i + 10,
      );

      pdf.addPage(
        pw.Page(
          pageFormat: PdfPageFormat.a4,
          margin: const pw.EdgeInsets.all(30),
          build: (context) {
            return pw.Wrap(
              spacing: 15,
              runSpacing: 15,
              children: chunk.map((s) => _buildCarnet(s)).toList(),
            );
          },
        ),
      );
    }

    // Abre la ventana nativa de impresión / guardar como PDF
    await Printing.layoutPdf(
      onLayout: (PdfPageFormat format) async => pdf.save(),
      name: 'Carnets_Recrea.pdf',
    );
  }

  static pw.Widget _buildCarnet(Map student) {
    final qrData = student['qr_code_string'] ?? 'RECREA-${student['dni']}';

    return pw.Container(
      width: carnetWidth,
      height: carnetHeight,
      decoration: pw.BoxDecoration(
        border: pw.Border.all(color: PdfColors.blue900, width: 2),
        borderRadius: pw.BorderRadius.circular(8),
        color: PdfColors.white,
      ),
      padding: const pw.EdgeInsets.all(12),
      child: pw.Row(
        children: [
          pw.Expanded(
            child: pw.Column(
              crossAxisAlignment: pw.CrossAxisAlignment.start,
              mainAxisAlignment: pw.MainAxisAlignment.center,
              children: [
                pw.Text(
                  'I.E.I. RECREA',
                  style: pw.TextStyle(fontWeight: pw.FontWeight.bold, fontSize: 14, color: PdfColors.blue900),
                ),
                pw.SizedBox(height: 10),
                pw.Text(
                  '${student['first_names']}\n${student['last_names']}',
                  style: pw.TextStyle(fontWeight: pw.FontWeight.bold, fontSize: 11),
                ),
                pw.SizedBox(height: 4),
                pw.Text('DNI: ${student['dni']}', style: const pw.TextStyle(fontSize: 10)),
                pw.SizedBox(height: 2),
                pw.Text(
                  student['classrooms']?['name'] ?? 'Aula no asignada',
                  style: const pw.TextStyle(fontSize: 9, color: PdfColors.grey700),
                ),
              ],
            ),
          ),
          pw.SizedBox(width: 8),
          // Genera el código QR nativo en el PDF
          pw.BarcodeWidget(
            barcode: pw.Barcode.qrCode(),
            data: qrData,
            width: 65,
            height: 65,
          ),
        ],
      ),
    );
  }
}
