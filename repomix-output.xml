                  child: const Icon(Icons.mail_rounded, color: RecreaTheme.turquesa, size: 20),
                ),
              ),
              validator: (value) => (value == null || value.isEmpty) ? 'Ingresa tu correo' : null,
            ),
            const SizedBox(height: 18),

            Text('Contraseña', style: Theme.of(context).textTheme.bodyLarge?.copyWith(fontSize: 14)),
            const SizedBox(height: 8),
            TextFormField(
              controller: _passwordController,
              obscureText: _obscurePassword,
              decoration: InputDecoration(
                hintText: '••••••••',
                prefixIcon: Container(
                  margin: const EdgeInsets.all(8),
                  decoration: BoxDecoration(color: RecreaTheme.rosaSuave, borderRadius: BorderRadius.circular(12)),
                  child: const Icon(Icons.lock_rounded, color: RecreaTheme.rosa, size: 20),
                ),
                suffixIcon: IconButton(
                  icon: Icon(_obscurePassword ? Icons.visibility_off_rounded : Icons.visibility_rounded, color: RecreaTheme.textoMudo),
                  onPressed: () => setState(() => _obscurePassword = !_obscurePassword),
                ),
              ),
              validator: (value) => (value == null || value.isEmpty) ? 'Ingresa tu contraseña' : null,
            ),
            const SizedBox(height: 28),

            Container(
              decoration: BoxDecoration(
                borderRadius: BorderRadius.circular(18),
                boxShadow: [BoxShadow(color: RecreaTheme.turquesa.withOpacity(0.35), blurRadius: 16, offset: const Offset(0, 6))],
